# Configurações do Sistema de Consulta SEFAZ
# Copie este arquivo para .env e preencha com suas credenciais

# Credenciais do Portal SEFAZ
SEFAZ_USUARIO=seu_usuario_aqui
SEFAZ_SENHA=sua_senha_aqui

# Configurações do Navegador
# Defina como "True" para executar sem abrir janela do navegador
HEADLESS_MODE=False

# Configurações de Retry
# Número máximo de tentativas para reprocessar empresas com erro
MAX_TENTATIVAS_RETRY=3

# Configurações de Interface
# Defina como "True" se seu terminal suporta emojis
USAR_EMOJIS=False
